# Settings for the SINGLE container (jackdiva/habitflow:all-<tag>).
# The four-container docker compose setup uses .env.example instead.
#
# On Render: paste these as the Web Service's Environment Variables
#   (Environment -> "Add from .env" accepts this file's format).
# Locally:   cp .env.single.example .env.single, fill it in, then
#   docker compose -f docker-compose.single.yml up -d
#   or: docker run -d --env-file .env.single -v habitflow_data:/data jackdiva/habitflow:all-<tag>
#
# Never commit a filled-in copy (.env.single is gitignored).

# --- Required -------------------------------------------------------------

# Your Neon connection string, DIRECT address (remove "-pooler" from the host):
#   postgresql://neondb_owner:<password>@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Leave it out only to use the built-in database, and then ONLY with a
# persistent volume at /data (never on Render's free plan: its disk is wiped).
DATABASE_URL=

# A bot token from @BotFather. Use a separate bot for each running copy:
# Telegram lets only one program read a bot's messages.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (@userinfobot). Everyone else is ignored.
TELEGRAM_ALLOWED_USER_ID=

# From https://console.groq.com
GROQ_API_KEY=

# --- Optional (defaults shown). Leave commented out rather than blank: -----
# --- an empty value overrides the default. --------------------------------

# GROQ_MODEL_NAME=llama-3.3-70b-versatile
# APP_TIMEZONE=Asia/Kolkata          # what "today", "this week", "this month" mean

# Render free web services sleep after 15 min without inbound requests; the
# container requests its own public URL (RENDER_EXTERNAL_URL, set by Render)
# to stay awake. Only used when PORT is set.
# KEEP_AWAKE=1                        # 0 turns it off
# KEEP_AWAKE_MINUTES=10
# KEEP_AWAKE_URL=                     # only if not on Render: your public URL

# DATABASE_POOL=auto                  # auto: Neon connections close after 60s idle so it can sleep; on|idle|off
# LLM_TIMEOUT_SECONDS=20              # per LLM attempt (3 attempts)
# API_LLM_TIMEOUT_SECONDS=90          # must exceed 3 x LLM_TIMEOUT_SECONDS

# Built-in database only (no DATABASE_URL): role and database name.
# POSTGRES_USER=habitflow
# POSTGRES_DB=habitflow

# Set by the platform, don't set these yourself on Render:
#   PORT (Render: 10000), RENDER, RENDER_EXTERNAL_URL
