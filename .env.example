POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>
DATABASE_URL=


TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id; everyone else is ignored.
TELEGRAM_ALLOWED_USER_ID=

GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Optional (defaults shown). Leave commented out rather than blank:
# an empty value overrides the default.
# APP_TIMEZONE=Asia/Kolkata          # what "today" means, in api and llm
# LLM_TIMEOUT_SECONDS=20             # api -> llm, per attempt (3 attempts)
# API_LLM_TIMEOUT_SECONDS=90         # bot -> api, must exceed 3 x LLM_TIMEOUT_SECONDS
